{
  // Confira se "name" é igual ao nome do seu Worker no Cloudflare
  "name": "myqrcode",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "QR_LINKS",
      // Troque pelo ID do namespace KV criado no Cloudflare
      "id": "41bdf35467ae47658dab7ba5b9eb8f1b"
    }
  ]
}
